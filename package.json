{
  "name": "fartola",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "fartOLa — orienteering competition system (workspace root)",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "dev:tabs": "bash scripts/dev.sh",
    "dev:stop": "bash scripts/dev.sh --stop",
    "dev:status": "bash scripts/dev.sh --status",
    "lint": "pnpm -r --if-present run lint && pnpm run lint:attribution && pnpm run lint:meos && pnpm run lint:compliance && pnpm run lint:icons",
    "lint:meos": "bash scripts/check-meos-attribution.sh",
    "lint:compliance": "node scripts/check-compliance.mjs",
    "lint:icons": "node scripts/check-icons.mjs",
    "lint:attribution": "bash scripts/check-mit-attribution.sh",
    "format": "prettier --write '**/*.{ts,js,cjs,mjs,md,yml,yaml,json}'",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:quick": "pnpm --filter @fartola/edge test && pnpm --filter @fartola/shared-types test && pnpm --filter @fartola/web test",
    "e2e": "playwright test",
    "build:fartola": "bash scripts/build-fartola.sh",
    "test:install": "node --test --test-reporter=spec --import tsx tests/install/install-smoke.test.ts",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "lefthook": "^2.1.16",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
