{
  "name": "@fartola/web",
  "version": "0.0.0",
  "description": "fartOLa web client — SvelteKit PWA (adapter-static SPA) served by the edge bridge",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "vite dev --port 5173",
    "build": "vite build",
    "dev:demo": "vite --config vite.demo.config.ts --port 5180",
    "build:demo": "svelte-kit sync && vite build --config vite.demo.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "svelte-kit sync && tsc --noEmit && svelte-check",
    "lint": "eslint src"
  },
  "dependencies": {
    "@fartola/shared-types": "workspace:*",
    "@lucide/svelte": "^1.61.0",
    "i18next": "^26.5.6"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "jsdom": "^30.1.3",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
